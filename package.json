{
  "name": "nest-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:content && next build",
    "check:content": "node scripts/check-published-content.mjs",
    "test:content": "node --test tests/published-content.test.mjs",
    "content:import": "node scripts/import-published-content.mjs",
    "check": "npm run lint && next typegen && npm run typecheck && npm run test:content && npm run build && npm run check:export",
    "check:export": "node scripts/check-static-export.mjs && node scripts/check-public-metadata.mjs",
    "start": "node tests/static-server.mjs out 4173",
    "preview": "node tests/static-server.mjs out 4173",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
